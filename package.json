  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "env:generate": "node scripts/generate-environment.js",
    "env:generate:prod": "ENVIRONMENT=production node scripts/generate-environment.js",
    "prestart": "npm run env:generate",
    "prebuild": "npm run env:generate:prod",
    "prelint": "npm run env:generate",
    "pretest": "npm run env:generate",
    "start": "ng serve --host 127.0.0.1",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "playwright test",
    "server": "node server.js"
  },
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@angular/animations": "^19.2.0",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.0",
    "@angular/cli": "^19.2.0",
    "@angular/compiler-cli": "^19.2.0",
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.49.0",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.0",
    "@types/spotify-web-playback-sdk": "^0.1.3",
    "angular-eslint": "19.2.0",
    "body-parser": "^1.20.3",
    "config-yml": "^0.8.0",
    "cors": "^2.8.5",
    "eslint": "^9.20.0",
    "express": "^4.21.0",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "playmusic": "^2.3.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.23.0"
  }
